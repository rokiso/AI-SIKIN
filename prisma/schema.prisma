datasource db {
  provider = "postgresql"
}

enum AiInferenceStatus {
  SUCCESS
  TIMEOUT
  ERROR
}

model AiInferenceAuditLog {
  id                 String            @id @default(uuid())
  sessionId          String?           @map("session_id")
  provider           String
  modelName          String            @map("model_name")
  promptTemplateHash String            @map("prompt_template_hash")
  latencyMs          Int               @map("latency_ms")
  promptTokens       Int?              @map("prompt_tokens")
  completionTokens   Int?              @map("completion_tokens")
  totalTokens        Int?              @map("total_tokens")
  status             AiInferenceStatus
  errorMessage       String?           @map("error_message") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId])
  @@index([status, createdAt])
  @@map("ai_inference_audit_logs")
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// -----------------------------------------------------------------------------
// 1. 사용자 및 인증 도메인 (소유: OAuth 2.0 PKCE 기반 소셜 간편 로그인...)
// -----------------------------------------------------------------------------

enum UserRole {
  GUEST
  USER
  ADMIN
}

enum AuthProvider {
  KAKAO
  GOOGLE
}

model User {
  id                 String               @id @default(uuid())
  email              String?              @unique
  nickname           String
  role               UserRole             @default(USER)
  snapshotUploads    SnapshotUploadSession[]
  imageUploads       ImageUploadSession[]
  accounts           UserAccount[]
  sessions           AuthSession[]
  diagnosticSessions DiagnosticSession[]
  dailySnapshots     DailySnapshot[]
  consentHistory     UserConsentHistory[]
  createdAt          DateTime             @default(now()) @db.Timestamptz @map("created_at")
  updatedAt          DateTime             @updatedAt @db.Timestamptz @map("updated_at")

  @@map("users")
}

model UserAccount {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @db.Timestamptz @map("created_at")

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "uq_provider_account")
  @@index([userId])
  @@map("user_accounts")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  sessionToken String    @unique @map("session_token")
  expiresAt    DateTime  @db.Timestamptz @map("expires_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("auth_sessions")
}

// No user FK, raw user ID, IP, file key or provider identity is retained.
// The keyed digest is pseudonymous audit metadata, not a claim of anonymity.
model DeletionAuditLog {
  id                  String   @id @default(uuid())
  userHash            String   @map("user_hash")
  deletedImagesCount  Int      @map("deleted_images_count")
  deletedRecordsCount Int      @map("deleted_records_count")
  completedAt         DateTime @default(now()) @db.Timestamptz @map("completed_at")

  @@index([userHash])
  @@map("deletion_audit_logs")
}

enum ConsentType {
  BIOMETRIC_FACE_DATA
}

model ConsentTermsVersion {
  id              String @id @default(uuid())
  consentType     ConsentType @map("consent_type")
  version         String
  title           String
  contentMarkdown String @map("content_markdown") @db.Text
  isActive        Boolean @default(false) @map("is_active")
  enactedAt       DateTime @map("enacted_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  consents        UserConsentHistory[]

  @@unique([consentType, version], name: "uq_terms_type_version", map: "uq_terms_type_version")
  @@index([consentType, isActive])
  @@map("consent_terms_versions")
}

model UserConsentHistory {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  guestDeviceId   String?  @map("guest_device_id")
  termsVersionId  String?  @map("terms_version_id")
  consentType     ConsentType @default(BIOMETRIC_FACE_DATA) @map("consent_type")
  sensitiveAgreed Boolean  @map("sensitive_agreed")
  termsVersion    String   @map("terms_version")
  ipAddress       String?  @map("ip_address")
  ipSource        String   @default("UNAVAILABLE") @map("ip_source")
  userAgent       String?  @map("user_agent")
  agreedAt        DateTime @default(now()) @db.Timestamptz @map("agreed_at")

  user            User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms           ConsentTermsVersion? @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)

  @@index([userId, consentType])
  @@index([guestDeviceId, consentType])
  @@index([termsVersionId])
  @@map("user_consent_histories")
}

// -----------------------------------------------------------------------------
// 2. 이미지 및 진단 세션 도메인 (소유: 의도: 서버 부하를 방지..., 바우만 12문항...)
// -----------------------------------------------------------------------------

enum UploadStatus {
  PENDING
  UPLOADED
  EXPIRED
  FAILED
}

model ImageUploadSession {
  id              String        @id @default(uuid())
  guestDeviceId   String?       @map("guest_device_id")
  userId          String?       @map("user_id")
  s3Key           String        @unique @map("s3_key")
  mimeType        String        @map("mime_type")
  fileSizeBytes   Int           @map("file_size_bytes")
  etag            String?       @map("etag")
  status          UploadStatus  @default(PENDING)
  expiresAt       DateTime      @db.Timestamptz @map("expires_at")
  createdAt       DateTime      @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime      @updatedAt @db.Timestamptz @map("updated_at")

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosticSessions DiagnosticSession[]

  @@index([guestDeviceId])
  @@index([userId])
  @@index([status, expiresAt])
  @@map("image_upload_sessions")
}

enum DiagnosticSessionStatus {
  SURVEY_COMPLETED
  ANALYSIS_PENDING
  COMPLETED
  FAILED
}

model DiagnosticSession {
  id              String                  @id @default(uuid())
  guestDeviceId   String?                 @map("guest_device_id")
  userId          String?                 @map("user_id")
  uploadSessionId String?                 @map("upload_session_id")
  status          DiagnosticSessionStatus @default(SURVEY_COMPLETED)
  surveyAnswers   Json                    @map("survey_answers")
  axisScores      Json                    @map("axis_scores")
  createdAt       DateTime                @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime                @updatedAt @db.Timestamptz @map("updated_at")

  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report          DiagnosticReport?
  uploadSession   ImageUploadSession?     @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)

  @@index([guestDeviceId])
  @@index([userId])
  @@index([status])
  @@index([uploadSessionId])
  @@map("diagnostic_sessions")
}

model DiagnosticReport {
  id                      String                  @id @default(uuid())
  sessionId               String                  @unique @map("session_id")
  baumannType             String                  @map("baumann_type") // 16가지 표준 코드 (OSNW 등)
  oilinessScore           Int                     @map("oiliness_score")
  sensitivityScore        Int                     @map("sensitivity_score")
  pigmentationScore       Int                     @map("pigmentation_score")
  elasticityScore         Int                     @map("elasticity_score")
  summaryText             String                  @db.Text @map("summary_text")
  recommendedIngredients  String[]                @default([]) @map("recommended_ingredients")
  cautionIngredients      String[]                @default([]) @map("caution_ingredients")
  isFallback              Boolean                 @default(false) @map("is_fallback")
  fallbackReason          String?                 @map("fallback_reason")
  aiAuditMetadata         Json                    @map("ai_audit_metadata")
  createdAt               DateTime                @default(now()) @db.Timestamptz @map("created_at")

  session                 DiagnosticSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productRecommendations  ProductRecommendation[]
  procedureGuideMappings  ProcedureGuideMapping[]

  @@index([baumannType])
  @@map("diagnostic_reports")
}

// -----------------------------------------------------------------------------
// 3. 카탈로그 및 추천 도메인 (본 작업이 테이블 스키마 소유)
// -----------------------------------------------------------------------------

enum ProductCategory {
  TONER
  SERUM
  CREAM
  SUNCARE
}

enum CautionLevel {
  INFO
  CAUTION
  WARNING
}

enum BaumannAxisTarget {
  ALL
  OILY
  DRY
  SENSITIVE
  RESISTANT
  PIGMENTED
  NON_PIGMENTED
  WRINKLED
  TIGHT
}

model IngredientCautionRule {
  id            String            @id @default(uuid())
  standardName  String            @unique @map("standard_name")
  inciName      String?           @map("inci_name")
  aliases       String[]          @default([])
  targetAxis    BaumannAxisTarget  @map("target_axis")
  cautionLevel  CautionLevel      @default(CAUTION) @map("caution_level")
  reasonKo      String            @db.Text @map("reason_ko")
  descriptionKo String            @db.Text @map("description_ko")
  createdAt     DateTime          @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime          @updatedAt @db.Timestamptz @map("updated_at")

  @@index([targetAxis])
  @@map("ingredient_caution_rules")
}

model Product {
  id              String                  @id @default(uuid())
  brandName       String                  @map("brand")
  productName     String                  @map("name")
  category        ProductCategory         @map("category")
  ingredients     String[]                @map("ingredients")
  suitableBaumannTypes String[]                @map("target_types") // 예: ["OSNW", "DSNW"]
  isPrimary       Boolean                 @default(true) @map("is_primary")
  affiliateBaseUrl String                  @map("affiliate_url")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime                @updatedAt @db.Timestamptz @map("updated_at")

  keyIngredients String[] @default([]) @map("key_ingredients")
  fullIngredients String @default("") @map("full_ingredients") @db.Text
  thumbnailUrl String? @map("thumbnail_url")
  status ProductStatus @default(ACTIVE)
  healthCheckFailCount Int @default(0) @map("health_check_fail_count")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz
  recommendations ProductRecommendation[]
  clickLogs AffiliateClickLog[]

  @@index([category, isActive])
  @@map("products")
}

model ProductRecommendation {
  id            String           @id @default(uuid())
  reportId      String           @map("report_id")
  productId     String           @map("product_id")
  category      ProductCategory  @map("category")
  recommendationReason String @map("match_reason")
  tier RecommendationTier @default(PRIMARY)
  targetIngredients String[] @default([]) @map("target_ingredients")
  createdAt     DateTime         @default(now()) @db.Timestamptz @map("created_at")

  report        DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reportId, category, tier], name: "uq_report_category_tier")
  @@index([reportId])
  @@index([productId])
  @@map("product_recommendations")
}

enum SkinConcernType {
  ACNE_SCAR
  PIGMENTATION
  PORE_SEBUM
  ELASTICITY
  BARRIER_REDNESS
}

model MedicalProcedure {
  id              String                  @id @default(uuid())
  nameKo          String                  @map("name_ko")
  principleText   String                  @db.Text @map("principle_text")
  recommendedInterval String              @map("recommended_interval")
  sideEffects     String[]                @map("side_effects")
  minPriceKrw     Int?                    @map("min_price_krw")
  maxPriceKrw     Int?                    @map("max_price_krw")
  code            String?                 @unique
  aliases         String[]                @default([])
  concernType     SkinConcernType?        @map("concern_type")
  recoveryPeriod  String?                 @map("recovery_period")
  checklistQuestions String[]             @default([]) @map("checklist_questions")
  sortOrder       Int                     @default(0) @map("sort_order")
  priceBasis      String?                 @map("price_basis")
  priceObservations Json                  @default("[]") @map("price_observations")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime                @updatedAt @db.Timestamptz @map("updated_at")

  mappings        ProcedureGuideMapping[]
  safetyGuide     ProcedureSafetyGuide?

  @@index([concernType, isActive])
  @@index([sortOrder])
  @@map("medical_procedures")
}

model ProcedureSafetyGuide {
  id                   String   @id @default(uuid())
  procedureId          String   @unique @map("procedure_id")
  slug                 String   @unique
  commonSideEffects    String[] @map("common_side_effects")
  rareRisks            String[] @map("rare_risks")
  contraindications    String[] @map("contraindications")
  postCareInstructions String[] @map("post_care_instructions")
  defenseQuestions     Json     @map("defense_questions")
  disclaimerText       String   @db.Text @map("disclaimer_text")
  createdAt            DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt            DateTime @updatedAt @db.Timestamptz @map("updated_at")
  procedure            MedicalProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("procedure_safety_guides")
}

// A shared, short-lived request quota. No raw client IP or user identifier.
model ProcedureSafetyRateLimit {
  keyHash      String   @id @map("key_hash")
  requestCount Int      @map("request_count")
  expiresAt    DateTime @db.Timestamptz @map("expires_at")

  @@index([expiresAt])
  @@map("procedure_safety_rate_limits")
}

model ProcedureGuideMapping {
  id          String           @id @default(uuid())
  reportId    String           @map("report_id")
  procedureId String           @map("procedure_id")
  concernType String           @map("concern_type") // 예: "PIGMENTATION", "TROUBLE", "WRINKLE"
  createdAt   DateTime         @default(now()) @db.Timestamptz @map("created_at")

  report      DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  procedure   MedicalProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([procedureId])
  @@map("procedure_guide_mappings")
}

// -----------------------------------------------------------------------------
// 4. 데일리 스냅샷 도메인 (소유: 1일 1회 안면 스냅샷 업로드...)
// -----------------------------------------------------------------------------

enum SkinConditionLevel {
  LOW
  BALANCED
  HIGH
}

enum SnapshotFeedbackSource {
  GENERAL_GUIDANCE
  AI
}

model DailySnapshot {
  idempotencyKey String? @map("idempotency_key")
  etag String?
  feedbackSource SnapshotFeedbackSource @default(GENERAL_GUIDANCE) @map("feedback_source")
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  s3Key           String             @map("s3_key")
  recordDate      DateTime           @db.Date @map("record_date")
  feedbackComment String             @db.Text @map("feedback_comment")
  hydrationLevel  SkinConditionLevel @default(BALANCED) @map("hydration_level")
  soothingLevel   SkinConditionLevel @default(BALANCED) @map("soothing_level")
  sebumLevel      SkinConditionLevel @default(BALANCED) @map("sebum_level")
  createdAt       DateTime           @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime           @updatedAt @db.Timestamptz @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey], name: "uq_snapshot_idempotency")
  @@unique([userId, recordDate], name: "uq_user_daily_snapshot")
  @@index([userId, recordDate])
  @@map("daily_snapshots")
}

// Short-lived one-use OAuth flow identifier; no provider token or profile is stored.
model OAuthAttempt {
  ownerHash String? @map("owner_hash")
  stateHash String   @id @map("state_hash")
  expiresAt DateTime @db.Timestamptz @map("expires_at")

  @@index([expiresAt])
  @@index([ownerHash, expiresAt])
  @@map("oauth_attempts")
}

model SnapshotUploadSession {
  id String @id
  userId String @map("user_id")
  s3Key String @unique @map("s3_key")
  mimeType String @map("mime_type")
  fileSizeBytes Int @map("file_size_bytes")
  recordDate DateTime @db.Date @map("record_date")
  status UploadStatus @default(PENDING)
  etag String?
  expiresAt DateTime @db.Timestamptz @map("expires_at")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("snapshot_upload_sessions")
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  UNAVAILABLE
}
enum RecommendationTier {
  PRIMARY
  SECONDARY
}
model AffiliateClickLog {
  id String @id @default(uuid())
  productId String @map("product_id")
  reportId String? @map("report_id")
  userId String? @map("user_id")
  guestDeviceId String? @map("guest_device_id")
  tier RecommendationTier @default(PRIMARY)
  sourceBaumannType String? @map("source_baumann_type") @db.VarChar(4)
  targetUrl String @map("target_url") @db.Text
  userAgent String? @map("user_agent") @db.VarChar(512)
  clickedAt DateTime @default(now()) @map("clicked_at") @db.Timestamptz
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId, clickedAt])
  @@index([userId])
  @@index([guestDeviceId])
  @@map("affiliate_click_logs")
}

enum LinkHealthStatus {
  HEALTHY
  UNHEALTHY
  TIMEOUT
  REDIRECT_LOOP
}

enum LinkActionTaken {
  NONE
  SWITCHED_TO_FALLBACK
  FALLBACK_FAILED
  MANUAL_ATTENTION_REQUIRED
}

model AffiliateLinkHealthLog {
  id                String           @id @default(uuid())
  productId         String           @map("product_id")
  checkedUrl        String           @map("checked_url") @db.Text
  httpStatusCode    Int?             @map("http_status_code")
  responseTimeMs    Int              @map("response_time_ms")
  status            LinkHealthStatus
  errorMessage      String?          @map("error_message") @db.Text
  actionTaken        LinkActionTaken  @default(NONE) @map("action_taken")
  fallbackProductId String?          @map("fallback_product_id")
  checkedAt         DateTime         @default(now()) @map("checked_at") @db.Timestamptz

  @@index([productId, checkedAt])
  @@index([status, checkedAt])
  @@map("affiliate_link_health_logs")
}

model AffiliateLinkHealthQuota {
  id           Int @id
  minute       Int
  requestCount Int @map("request_count")

  @@map("affiliate_link_health_quota")
}
