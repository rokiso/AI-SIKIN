{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectPrivateVaultVersioning",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__"
    },
    {
      "Sid": "ListPrivateImageVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__",
      "Condition": { "StringLike": { "s3:prefix": ["raw-faces/*", "daily-snapshots/*"] } }
    },
    {
      "Sid": "ErasePrivateImagesAndVerifyAbsence",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET_NAME__/raw-faces/*",
        "arn:aws:s3:::__BUCKET_NAME__/daily-snapshots/*"
      ]
    }
  ]
}
