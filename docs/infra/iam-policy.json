{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateImageUploadAndReadOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET_NAME__/raw-faces/*",
        "arn:aws:s3:::__BUCKET_NAME__/daily-snapshots/*"
      ]
    }
  ]
}
