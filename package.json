{
  "name": "ai-sikin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "node scripts/dev-database.mjs up",
    "db:stop": "node scripts/dev-database.mjs stop",
    "db:generate": "node --conditions=react-server --import tsx scripts/database.ts generate",
    "db:validate": "node --conditions=react-server --import tsx scripts/database.ts validate",
    "db:format": "node --conditions=react-server --import tsx scripts/database.ts format",
    "db:migrate": "node --conditions=react-server --import tsx scripts/database.ts migrate",
    "db:status": "node --conditions=react-server --import tsx scripts/database.ts status",
    "db:seed": "node --conditions=react-server --import tsx scripts/database.ts seed",
    "test:db": "vitest run --config vitest.database.config.ts",
    "format:check": "prettier --check app/manifest.ts components/pwa components/system lib/server-env.ts lib/prisma.ts lib/database-development.ts scripts prisma.config.ts prisma/seed.ts compose.yaml .prettierrc.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
