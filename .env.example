# Run npm run db:up to create a private local .env with random credentials.
POSTGRES_DB=sikin_dev
POSTGRES_USER=sikin_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://sikin_app:replace-with-a-local-development-password@127.0.0.1:55432/sikin_dev
# Explicit opt-in for inactive, fictional development catalog fixtures only.
ALLOW_SAMPLE_SEED=false
# Generated locally by db:up; use a private random value of at least 32 characters.
AUTH_COOKIE_SECRET=replace-with-a-private-random-signing-key

# Keep off until production migrations and real storage erasure verification are complete.
ACCOUNT_DELETION_ENABLED=0

# Private image vault (server only). Configure a private AES256-enforced bucket.
S3_VAULT_BUCKET=replace-with-private-bucket
S3_VAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-with-server-key
AWS_SECRET_ACCESS_KEY=replace-with-server-secret
# Optional S3-compatible endpoint; plain HTTP permitted only on loopback in development.
S3_ENDPOINT=

# OAuth providers (server secrets; configure matching callbacks in each console)
NEXT_PUBLIC_APP_URL=https://your-app.example
# Optional; leave blank to derive /auth/callback/[provider] from the app origin.
# Never use the POST /api/v1/auth/callback/[provider] endpoint as a redirect URI.
GOOGLE_REDIRECT_URI=
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# Optional daily-snapshot AI. Leave both unset to store a photo with explicit general guidance.
SNAPSHOT_AI_API_KEY=replace-with-server-only-key
SNAPSHOT_AI_MODEL=replace-with-compatible-vision-model

# Optional: device-only photo preview without upload, login or AI
# Also enabled automatically when S3_VAULT_BUCKET is absent.
PHOTO_TEST_MODE=1

# Exact approved HTTPS seller hosts for redirects and health checks (comma-separated).
# Empty by default: no purchase redirect is enabled without a reviewed seller.
CATALOG_AFFILIATE_HOSTS=

# Keep 0 for public shopping previews. Enable only after DB migrations and real catalog setup.
CATALOG_LIVE_ENABLED=0

# Optional server-only multimodal foundation. No provider/model is activated by default.
AI_LIVE_ENABLED=0
AI_PROVIDER=OPENAI
AI_API_KEY=replace-with-server-ai-key
AI_MODEL_NAME=replace-with-explicit-supported-model
AI_REQUEST_TIMEOUT_MS=8000
# Private random base64url/hex token, at least 32 characters. No default token exists.
AI_HEALTHCHECK_TOKEN=replace-with-private-random-system-token

# Set only when your trusted ingress overwrites this header; otherwise leave blank.
# Allowed: x-forwarded-for, x-real-ip, x-vercel-forwarded-for. No fake IP fallback.
CONSENT_TRUSTED_IP_HEADER=

# Server-only partner metadata: use issued values after account approval.
# Format checks do not verify registration, settlement or a provider's URL contract.
AFFILIATE_PARTNER_ID=
AFFILIATE_DEFAULT_PLATFORM=

# Keep off in production until safety-guide/quota migrations and trusted IP setup are verified.
PROCEDURE_SAFETY_ENABLED=0

# Server-only bearer secret for the affiliate link health-check scheduler.
CRON_SECRET_TOKEN=
