# Run npm run db:up to create a private local .env with random credentials.
POSTGRES_DB=sikin_dev
POSTGRES_USER=sikin_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://sikin_app:replace-with-a-local-development-password@127.0.0.1:55432/sikin_dev
# Explicit opt-in for inactive, fictional development catalog fixtures only.
ALLOW_SAMPLE_SEED=false
# Generated locally by db:up; use a private random value of at least 32 characters.
AUTH_COOKIE_SECRET=replace-with-a-private-random-signing-key

# Private image vault (server only). Configure a private AES256-enforced bucket.
S3_VAULT_BUCKET=replace-with-private-bucket
S3_VAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-with-server-key
AWS_SECRET_ACCESS_KEY=replace-with-server-secret
# Optional S3-compatible endpoint; plain HTTP permitted only on loopback in development.
S3_ENDPOINT=

# OAuth providers (server secrets; configure matching callbacks in each console)
NEXT_PUBLIC_APP_URL=https://your-app.example
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
